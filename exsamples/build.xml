<project name="yourprojectname" default="build">
    <if>
        <not>
            <available file="${env.TSUMIKI_BUILDER_CORE_PATH}/builder.xml"></available>
        </not>
        <then>
            <fail message="${env.TSUMIKI_BUILDER_CORE_PATH}/builder.xml not found. you can register enviroment `php tsumiki-builder-install-path/src/register.php` "/>
        </then>
    </if>
    <target name="build">
        <phing phingfile="${env.TSUMIKI_BUILDER_CORE_PATH}/builder.xml" target="build"/>
    </target>
    <target name="install">
        <phing phingfile="${env.TSUMIKI_BUILDER_CORE_PATH}/builder.xml" target="install"/>
    </target>
    <target name="build-projects">
        <property name="builder.projectPath" value="{$project.dir}/projectA,{$project.dir}/projectB" />
        <phing phingfile="${env.TSUMIKI_BUILDER_CORE_PATH}/builder.xml" target="build"/>
    </target>
</project>
